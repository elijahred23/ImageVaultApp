{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ImageVaultApp (ASP.NET Core)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build ImageVaultApp",
      "program": "${workspaceFolder}/bin/Debug/net10.0/ImageVaultApp.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+http://(?:0\\.0\\.0\\.0|localhost):([0-9]+)",
        "uriFormat": "http://localhost:%s"
      }
    }
  ]
}
