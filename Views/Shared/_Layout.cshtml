<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ImageVaultApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ImageVaultApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ImageVaultApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Image" asp-action="Gallery">Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Image" asp-action="Upload">Upload</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Image" asp-action="Favorites">Favorites</a> 
                        </li>
                    </ul>
                </div>
            </div>
            @if(User.Identity.IsAuthenticated)
            {
                <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline" >
                    @Html.AntiForgeryToken()
                    <button type="submit">Logout</button>
                </form>
            }
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ImageVaultApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <!-- Lightbox Modal -->
    <div class="modal fade" id="lightboxModal" tabindex="-1" aria-labelledby="lightboxModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content bg-dark border-0">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0 text-center position-relative">
                    <div id="lightboxStage" class="lightbox-stage">
                        <img id="lightboxImage" src="#" alt="Lightbox Image" class="rounded lightbox-image" />
                    </div>
                    <div id="lightboxCaption" class="py-3 text-white bg-black bg-opacity-50 mt-2"></div>
                    
                    <div class="pb-3 d-flex flex-wrap justify-content-center align-items-center gap-2 px-3">
                        <button id="zoomOutImage" class="btn btn-outline-light" type="button">Smaller</button>
                        <input id="lightboxZoomSlider" class="form-range lightbox-zoom-slider" type="range" min="25" max="400" step="25" value="100" aria-label="Image zoom" />
                        <button id="zoomInImage" class="btn btn-outline-light" type="button">Bigger</button>
                        <button id="panImageLeft" class="btn btn-outline-light" type="button">Left</button>
                        <button id="panImageUp" class="btn btn-outline-light" type="button">Up</button>
                        <button id="panImageDown" class="btn btn-outline-light" type="button">Down</button>
                        <button id="panImageRight" class="btn btn-outline-light" type="button">Right</button>
                        <button id="resetImageZoom" class="btn btn-outline-light" type="button">Reset</button>
                        <span id="lightboxZoomLabel" class="text-white-50 small lightbox-zoom-label">100%</span>
                    </div>
                    <div class="pb-4">
                        <button id="prevImage" class="btn btn-outline-light me-2">&larr; Previous</button>
                        <button id="nextImage" class="btn btn-outline-light">Next &rarr;</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
