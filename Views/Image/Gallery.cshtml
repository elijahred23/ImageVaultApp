@model List<Image>
@{
    var settings = (UserSettings) ViewBag.Settings;
}

<h2>Gallery</h2>

@foreach (var img in Model)
{
    <div style="margin-bottom:20px">
        @if(img.IsNSFW && !settings.AllowNSFW)
        {
            <p>NSFW Hidden</p>
        }
        else if (img.IsNSFW && settings.BlurNSFW)
        {
            <div style="filter:blur(15px);">
                <img src="@img.ImageUrl" width="300" />
            </div>
        }
        else {
            <img src="@img.ImageUrl" width="300" />
        }
    </div>
}