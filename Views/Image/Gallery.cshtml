@model GalleryViewModel
@Html.AntiForgeryToken()
@{
    var settings = ViewBag.Settings as UserSettings;
    var allowNSFW = settings?.AllowNSFW ?? false;
    var blurNSFW = settings?.BlurNSFW ?? true;
    var favoriteImageIds = ViewBag.FavoriteImageIds as List<int> ?? new List<int>();
    var displayImages = Model.Images.ToList();
    var startPage = Math.Max(1, Model.Page - 2);
    var endPage = Math.Min(Model.TotalPages, Model.Page + 2);
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3 border-bottom pb-4">
        <div>
            <h1 class="fw-bold mb-0 text-primary">Secure Vault</h1>
            <p class="text-muted">
                Browsing
                <span id="galleryImageCount">@displayImages.Count</span>
                of @Model.TotalImages images in your collection
            </p>
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2 align-items-sm-start">

        <form asp-action="Gallery" method ="get" class="mb-4">
            <div class="input-group">
                <input autocomplete="off" type="text" name="searchTerm" class="form-control" placeholder = "Search Images by title or description" 
                    value ="@Model.SearchTerm" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />

                <button class ="btn btn-primary" type="submit">Search</button>
                @if(!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a class="btn btn-secondary" href="@Url.Action("Gallery")">Clear</a>
                }
            </div>
        </form>
        <a class="btn btn-outline-primary mb-4"
           asp-action="DownloadImageUrls"
           asp-route-searchTerm="@Model.SearchTerm">
            Download JSON
        </a>
        <form asp-action="Gallery" method="get" id="galleryPageSizeForm" class="mb-4">
            <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
            <input type="hidden" name="page" value="1" />
            <div class="input-group">
                <span class="input-group-text">Per page</span>
                <select id="galleryPageSizeInput" class="form-select" name="pageSize" aria-label="Images per page">
                    @for(var pageSizeOption = 100; pageSizeOption <= 1000; pageSizeOption += 100)
                    {
                        if(pageSizeOption == Model.PageSize)
                        {
                            <option value="@pageSizeOption" selected>@pageSizeOption</option>
                        }
                        else
                        {
                            <option value="@pageSizeOption">@pageSizeOption</option>
                        }
                    }
                </select>
            </div>
        </form>
        </div>
    </div>

    @if(!displayImages.Any())
    {
        <div id="emptyGalleryMessage" class="text-center py-5 border-rounded-4 bg-light shadow-sm">
            <p class="text-muted mb-0">No images found in your vault.</p>
        </div>
    }
    else {
        <div id="galleryGrid" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" data-allow-nsfw="@allowNSFW.ToString().ToLowerInvariant()" data-blur-nsfw="@blurNSFW.ToString().ToLowerInvariant()">
            @foreach(var image in displayImages)
            {
                var isBlurred = image.IsNSFW && blurNSFW;
                var isFavorited = favoriteImageIds.Contains(image.Id);

                <div class="col gallery-item"
                    data-image-id="@image.Id"
                    data-title="@image.Title"
                    data-description="@image.Description"
                    data-is-nsfw="@image.IsNSFW.ToString().ToLowerInvariant()">
                    <div class="card h-100 shadow-sm">
                        <div class="position-relative">
                            <img src="@image.ImageUrl" data-title="@image.Title" class="gallery-img card-img-top @(isBlurred ? "nsfw-blur-effect" : "") object-fit-cover" alt="@image.Title" />
                            <button class="btn btn-sm favorite-toggle @(isFavorited ? "btn-danger" : "btn-outline-danger") position-absolute top-0 end-0 m-2 rounded-circle" 
                                data-image-id="@image.Id">
                                <span class="favorite-icon">@(isFavorited ? "❤️" : "🤍")</span>
                            </button>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@image.Title</h5>
                            <p class="card-text text-truncate">@image.Description</p>
                            <p class="card-text mt-auto"><small class="text-muted">Uploaded on @image.CreatedAt.ToString("MMM dd, yyyy")</small></p>
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-secondary edit-image-button" data-image-id="@image.Id">Edit</button>
                                <form asp-action="Delete" asp-route-id="@image.Id" method="post" class="d-inline delete-image-form">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if(Model.TotalPages > 1)
        {
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-4">
                <div class="text-muted small">
                    Showing @Model.FirstItemIndex-@Model.LastItemIndex of @Model.TotalImages
                </div>
                <nav aria-label="Gallery pages">
                    <ul class="pagination mb-0 flex-wrap justify-content-center">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="@Url.Action("Gallery", new { searchTerm = Model.SearchTerm, page = Model.Page - 1, pageSize = Model.PageSize })">Previous</a>
                        </li>
                        @if(startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Gallery", new { searchTerm = Model.SearchTerm, page = 1, pageSize = Model.PageSize })">1</a>
                            </li>
                            @if(startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        @for(var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Gallery", new { searchTerm = Model.SearchTerm, page = pageNumber, pageSize = Model.PageSize })">@pageNumber</a>
                            </li>
                        }
                        @if(endPage < Model.TotalPages)
                        {
                            @if(endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Gallery", new { searchTerm = Model.SearchTerm, page = Model.TotalPages, pageSize = Model.PageSize })">@Model.TotalPages</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="@Url.Action("Gallery", new { searchTerm = Model.SearchTerm, page = Model.Page + 1, pageSize = Model.PageSize })">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>

<div class="modal fade" id="editImageModal" tabindex="-1" aria-labelledby="editImageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form id="editImageForm" asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editImageModalLabel">Edit Image</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="editImageId" />
                    <div class="row g-4">
                        <div class="col-md-5">
                            <img id="editCurrentImage" src="#" alt="Current image" class="img-fluid rounded border mb-3" />
                            <img id="editNewImagePreview" src="#" alt="New image preview" class="img-fluid rounded border d-none" />
                        </div>
                        <div class="col-md-7">
                            <div class="mb-3">
                                <label for="editImageTitle" class="form-label">Title</label>
                                <input type="text" class="form-control" name="Title" id="editImageTitle" autocomplete="off" />
                            </div>
                            <div class="mb-3">
                                <label for="editImageDescription" class="form-label">Description</label>
                                <textarea class="form-control" name="Description" id="editImageDescription" rows="4"></textarea>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="IsNSFW" value="true" id="editImageIsNSFW" />
                                <input type="hidden" name="IsNSFW" value="false" />
                                <label class="form-check-label" for="editImageIsNSFW">NSFW</label>
                            </div>
                            <div class="mb-3">
                                <label for="editImageFile" class="form-label">Replace Image</label>
                                <input type="file" class="form-control" name="NewFile" id="editImageFile" accept="image/*" />
                            </div>
                            <div id="editImageError" class="alert alert-danger d-none mb-0"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="editImageSubmit">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.gallery-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.gallery-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.2);
}
.nsfw-blur-effect {
    filter: blur(15px);
    transition: filter 0.3s ease;
}
.object-fit-cover {
    object-fit: cover;
}
</style>
