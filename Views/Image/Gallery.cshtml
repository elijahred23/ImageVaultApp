@model IEnumerable<Image>
@{
    var settings = ViewBag.Settings as UserSettings;
    var allowNSFW = settings?.AllowNSFW ?? false;
    var blurNSFW = settings?.BlurNSFW ?? true;
    var favoriteImageIds = ViewBag.FavoriteImageIds as List<int> ?? new List<int>();
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3 border-bottom pb-4">
        <div>
            <h1 class="fw-bold mb-0 text-primary">Secure Vault</h1>
            <p class="text-muted">Browsing @Model.Count() images in your collection</p>
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2">

        <form asp-action="Gallery" method ="get" class="mb-4">
            <div class="input-group">
                <input autocomplete="off" type="text" name="searchTerm" class="form-control" placeholder = "Search Images by title or description" 
                    value ="@ViewBag.SearchTerm" />

                <button class ="btn btn-primary" type="submit">Search</button>
                @if(!string.IsNullOrEmpty(ViewBag.SearchTerm))
                {
                    <a class="btn btn-secondary" href="@Url.Action("Gallery")">Clear</a>
                }
            </div>
        </form>
        </div>
    </div>

    @if(!Model.Any())
    {
        <div class="text-center py-5 border-rounded-4 bg-light shadow-sm">
            <p class="text-muted mb-0">No images found in your vault.</p>
        </div>
    }
    else {
        <div class="row rows-cols-1 rows-cols-sm-2 row-cols-3 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach(var image in Model)
            {
                if(image.IsNSFW && !allowNSFW)
                {
                    continue;
                }
                var isBlurred = image.IsNSFW && blurNSFW;
                var isFavorited = favoriteImageIds.Contains(image.Id);

                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="position-relative">
                            <a asp-action="Details" asp-route-id="@image.Id">
                                <img src="@image.ImageUrl" class="card-img-top @(isBlurred ? "nsfw-blur-effect" : "") object-fit-cover" alt="@image.Title" />
                            </a>
                            <form asp-action="ToggleFavorite" asp-route-id="@image.Id" method="post" class="position-absolute top-0 end-0 m-2">
                                <button type="submit" class="btn btn-sm @(isFavorited ? "btn-danger" : "btn-outline-secondary") rounded-circle">
                                    <span class="@(isFavorited ? "text-danger" : "text-muted")">@(isFavorited ? "❤" : "♡")</span>
                                </button>
                            </form>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@image.Title</h5>
                            <p class="card-text text-truncate">@image.Description</p>
                            <p class="card-text mt-auto"><small class="text-muted">Uploaded on @image.CreatedAt.ToString("MMM dd, yyyy")</small></p>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@image.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@image.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
<style>
.gallery-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.gallery-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.2);
}
.nsfw-blur-effect {
    filter: blur(15px);
    transition: filter 0.3s ease;
}
.object-fit-cover {
    object-fit: cover;
}
</style>
