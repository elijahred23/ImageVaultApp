@model List<Image>
@{
    var settings = (UserSettings) ViewBag.Settings;
}

<h2>Gallery</h2>
<form asp-action="Gallery" method ="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchTerm" class="form-control" placeholder = "Search Images by title or description" 
            value ="@ViewBag.SearchTerm" />

        <button class ="btn btn-primary" type="submit">Search</button>
        @if(!string.IsNullOrEmpty(ViewBag.SearchTerm))
        {
            <a class="btn btn-secondary" href="@Url.Action("Gallery")">Clear</a>
        }
    </div>
</form>

@foreach (var img in Model)
{
    <div style="margin-bottom:20px">
        @if(img.IsNSFW && !settings.AllowNSFW)
        {
            <span></span>
        }
        else if (img.IsNSFW && settings.BlurNSFW)
        {
            <div style="filter:blur(15px);">
                <img src="@img.ImageUrl" width="300" />
            </div>
        }
        else {
            <img src="@img.ImageUrl" width="300" />
            <a asp-action="Edit" asp-route-id="@img.Id">Edit</a>
        }
    </div>
}