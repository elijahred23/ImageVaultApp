@using ImageVaultApp.ViewModels
@model ImageUploadViewModel;

<h2>Upload Image</h2>

<form asp-action="Upload" method="post" enctype="multipart/form-data">
    <div>
        <label>Title</label>
        <input name="Title" />
    </div>

    <div>
        <label>Description</label>
        <input name="Description" />
    </div>
    <div>
        <label>File</label>
    </div>

    <div>
        <label>NSFW</label>
        <input asp-for="IsNSFW" type="checkbox" />
    </div>

    <button type="submit">Upload</button>
</form>
