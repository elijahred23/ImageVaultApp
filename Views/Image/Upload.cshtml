@using ImageVaultApp.ViewModels
@model ImageUploadViewModel;

<h2>Upload Image</h2>

<form asp-action="Upload" method="post" enctype="multipart/form-data">
    <div>
        <label>Title</label>
        <input name="Title" />
    </div>

    <div>
        <label>Description</label>
        <input name="Description" />
    </div>
    <hr />

    <div>
        <label>Paste Image URL or data:image</label>
        <input asp-for="ImageUrl" style="width:400px;" id="fileInput" />
    </div>
    <p>OR</p>
    <div>
        <label>Upload File (optional fallback)</label>
    </div>

    <div>
        <label>NSFW</label>
        <input asp-for="IsNSFW" type="checkbox" />
    </div>
    <div>
        <p>New Image Preview:</p>
        <img id="preview" src="#" alt="New Image Preview" style="max-width: 300px; display: none;" />
    </div>

    <button type="submit">Save Image</button>
</form>
<script>
    const fileInput = document.getElementById('fileInput');
    const preview = document.getElementById("preview");

    const isValidUrl = (string) => {
        try {
            new URL(string);
            return true;
        } catch (_) {
            return false;  
        }
    }
    fileInput.addEventListener('input', function() {
        const value = this.value;

        if(value.startsWith('data:image') || isValidUrl(value)) {
            preview.src = value;
            preview.style.display = 'block';
        }
    });

    fileInput.addEventListener('change', function() {
        const file = this.files[0];

        if(file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            };

            reader.readAsDataURL(file);
        }
    });
</script>
