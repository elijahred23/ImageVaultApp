@using ImageVaultApp.ViewModels
@model ImageUploadViewModel;

<h2>Upload Image</h2>

<form asp-action="Upload" method="post" enctype="multipart/form-data">
    <div>
        <label>Title</label>
        <input name="Title" />
    </div>

    <div>
        <label>Description</label>
        <input name="Description" />
    </div>
    <hr />

    <div>
        <label>Paste Image URL or data:image</label>
        <input asp-for="ImageUrl" style="width:400px;" />
    </div>
    <p>OR</p>
    <div>
        <label>Upload File (optional fallback)</label>
    </div>

    <div>
        <label>NSFW</label>
        <input asp-for="IsNSFW" type="checkbox" />
    </div>

    <button type="submit">Save Image</button>
</form>
